local function Notify(title, text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {Title=title, Text=text, Duration=5})
    end)
end

local function mainEngineLoad()
    Notify("MEKNOYUXLIMZ", "Key bener! Lagi load Hub...")
    print("[MEKNOYUXLIMZ] Loading Hub dari: "..HUB_URL)
    -- Ambil Hub dengan pcall biar error ketauan
    local ok, hubCode = pcall(function() return game:HttpGet(HUB_URL) end)
    if not ok or not hubCode or hubCode == "" then
        Notify("ERROR", "Gagal download Hub! Cek GitHub!")
        warn("[MEKNOYUXLIMZ] HttpGet GAGAL: "..tostring(hubCode))
        return
    end
    print("[MEKNOYUXLIMZ] Hub ke-download, panjang: "..#hubCode)
    local func, err = loadstring(hubCode)
    if not func then
        Notify("ERROR", "Hub error syntax: "..tostring(err))
        warn("[MEKNOYUXLIMZ] loadstring GAGAL: "..tostring(err))
        return
    end
    local ok2, err2 = pcall(func)
    if not ok2 then
        Notify("ERROR", "Hub crash pas jalan: "..tostring(err2))
        warn("[MEKNOYUXLIMZ] Hub CRASH: "..tostring(err2))
        return
    end
    Notify("MEKNOYUXLIMZ", "Hub berhasil ke-load!")
end

