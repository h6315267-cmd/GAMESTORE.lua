local function TryAutoLogin()
    if isfile and isfile(KEY_FILE) then
        local ok, content = pcall(readfile, KEY_FILE)
        if ok and content then
            local k = string.gsub(content, "%s+", "")
            if ValidKeys[k] then
                Notify(HUB_NAME, "Auto Login! Key Ke-Save...", 3)
                task.wait(0.3)
                LoadHub()
                return true
            end
        end
    end
    return false
end

