-- Cari game by PlaceId juga (buat backup kalo GameId gagal)
local function GetGameData()
    local gid = game.GameId
    local pid = game.PlaceId
    if GAMES[gid] then return GAMES[gid], gid end
    for _, data in pairs(GAMES) do
        if data.PlaceId == pid then return data, gid end
    end
    return nil, gid
end

-- ========== LOADER HUB - ROMBAKAN ==========
local function LoadHub()
    Notify(HUB_NAME, "Key Valid! Mendeteksi Game...", 3)
    task.wait(0.5)

    local data, gid = GetGameData()
    if not data then
        Notify(HUB_NAME, "Game ini belum support! GameId: "..tostring(gid), 6)
        warn("[MEKNOYUXLIMZ] Game tidak support - GameId: "..tostring(gid).." PlaceId: "..tostring(game.PlaceId))
        return
    end

    Notify(HUB_NAME, "Game: "..data.Name.." | Loading...", 3)
    print("[MEKNOYUXLIMZ] Load Game: "..data.Name.." | URL: "..data.Url)

    for attempt = 1, 3 do
        local ok, source = pcall(game.HttpGet, game, data.Url)
        if ok and type(source) == "string" and source ~= "" then
            local chunk, err = loadstring(source)
            if not chunk then
                Notify("ERROR", "Syntax Error: "..tostring(err), 6)
                warn("[MEKNOYUXLIMZ] Syntax: "..tostring(err))
                return
            end
            local ok2, err2 = pcall(chunk)
            if not ok2 then
                Notify("ERROR", "Hub Crash: "..tostring(err2), 6)
                warn("[MEKNOYUXLIMZ] Crash: "..tostring(err2))
            else
                Notify(HUB_NAME, data.Name.." Berhasil Di-Load!", 4)
            end
            return
        end
        warn("[MEKNOYUXLIMZ] Download gagal attempt "..attempt)
        task.wait(0.5)
    end
    Notify("ERROR", "Gagal Download Hub 3x!", 5)
end

