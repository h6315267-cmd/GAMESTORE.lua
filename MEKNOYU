local function MakeToggle(text, y, key)
    local B = Instance.new("TextButton", Main)
    B.Size = UDim2.new(1, -16, 0, 30)
    B.Position = UDim2.new(0, 8, 0, y)
    B.BackgroundColor3 = Config[key] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(45, 45, 55)
    B.BackgroundTransparency = 0.15
    B.Text = text .. " : " .. (Config[key] and "ON" or "OFF")
    B.TextColor3 = Color3.fromRGB(255, 255, 255)
    B.Font = Enum.Font.GothamBold
    B.TextSize = 11
    B.BorderSizePixel = 1
    B.BorderColor3 = Config[key] and Color3.fromRGB(120, 255, 120) or Color3.fromRGB(120, 120, 140)
    B.ZIndex = 3

    B.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        B.Text = text .. " : " .. (Config[key] and "ON" or "OFF")
        B.BackgroundColor3 = Config[key] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(45, 45, 55)
        B.BorderColor3 = Config[key] and Color3.fromRGB(120, 255, 120) or Color3.fromRGB(120, 120, 140)
        if key == "RenderOff" then
            pcall(function() RunService:Set3dRenderingEnabled(not Config.RenderOff) end)
        end
    end)
    return B
end

