-- ==========================================
-- 8. AUTO RESIZE PORTRAIT & LANDSCAPE HP
-- ==========================================
local isFirstLayout = true

local function updateResponsiveLayout()
	local vp = getViewportSize()
	local isPortrait = vp.Y >= vp.X

	if isPortrait then
		-- Mode HP Portrait: Lebar 90% layar, Tinggi 56% layar, Tab di atas (horizontal)
		local frameW = math.clamp(math.floor(vp.X * 0.90), 290, 440)
		local frameH = math.clamp(math.floor(vp.Y * 0.56), 340, 480)
		MainFrame.Size = UDim2.new(0, frameW, 0, frameH)

		TabsScroll.Position = UDim2.new(0, 10, 0, 66)
		TabsScroll.Size = UDim2.new(1, -20, 0, 50)
		TabsScroll.AutomaticCanvasSize = Enum.AutomaticSize.X
		TabsScroll.ScrollingDirection = Enum.ScrollingDirection.X
		TabsLayout.FillDirection = Enum.FillDirection.Horizontal

		for _, tabBtn in pairs(TabButtons) do
			tabBtn.Size = UDim2.new(0, 105, 1, 0)
		end

		ContentScroll.Position = UDim2.new(0, 10, 0, 122)
		ContentScroll.Size = UDim2.new(1, -20, 1, -145)
	else
		-- Mode HP Landscape / Tablet / PC: Tab di kanan (vertikal), Konten di kiri
		local frameW = math.clamp(math.floor(vp.X * 0.68), 420, 540)
		local frameH = math.clamp(math.floor(vp.Y * 0.78), 260, 340)
		MainFrame.Size = UDim2.new(0, frameW, 0, frameH)

		local tabW = math.clamp(math.floor(frameW * 0.27), 115, 145)
		TabsScroll.Position = UDim2.new(1, -(tabW + 10), 0, 66)
		TabsScroll.Size = UDim2.new(0, tabW, 1, -89)
		TabsScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		TabsScroll.ScrollingDirection = Enum.ScrollingDirection.Y
		TabsLayout.FillDirection = Enum.FillDirection.Vertical

		for _, tabBtn in pairs(TabButtons) do
			tabBtn.Size = UDim2.new(1, 0, 0, 38)
		end

		ContentScroll.Position = UDim2.new(0, 10, 0, 66)
		ContentScroll.Size = UDim2.new(1, -(tabW + 26), 1, -89)
	end

	if isFirstLayout then
		isFirstLayout = false
		MainFrame.Position = UDim2.new(
			0, math.floor((vp.X - MainFrame.Size.X.Offset) / 2),
			0, math.floor((vp.Y - MainFrame.Size.Y.Offset) / 2)
		)
	else
		clampFrameToScreen(MainFrame)
		clampFrameToScreen(MiniButton)
	end
end

updateResponsiveLayout()

local function bindCameraResize()
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateResponsiveLayout)
	end
end

bindCameraResize()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCameraResize)

