-- ==========================================
-- HELPER DRAG + CLAMP AGAR TIDAK KELUAR LAYAR
-- ==========================================
local function getViewportSize()
	local cam = workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(800, 450)
end

local function clampFrameToScreen(frame)
	local vp = getViewportSize()
	local absSize = frame.AbsoluteSize
	local absPos = frame.AbsolutePosition

	local maxX = math.max(0, vp.X - absSize.X)
	local maxY = math.max(0, vp.Y - absSize.Y)

	local clampedX = math.clamp(absPos.X, 0, maxX)
	local clampedY = math.clamp(absPos.Y, 0, maxY)

	frame.Position = UDim2.new(0, clampedX, 0, clampedY)
end

local function makeDraggable(frame, dragHandle)
	dragHandle = dragHandle or frame
	local dragging = false
	local dragInput, dragStart, startPos

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					clampFrameToScreen(frame)
				end
			end)
		end
	end)

	dragHandle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			local vp = getViewportSize()
			local absSize = frame.AbsoluteSize

			local newX = math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, vp.X - absSize.X))
			local newY = math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, vp.Y - absSize.Y))

			frame.Position = UDim2.new(0, newX, 0, newY)
		end
	end)
end

